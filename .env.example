# Salin ke .env lalu isi. Jangan commit .env.
# Dari `supabase status` (lokal) atau dasbor proyek. Service role HANYA untuk services/nlp.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=
# Opsional: hanya untuk proyek yang masih memakai JWT secret lama (HS256). Kunci baru diverifikasi lewat JWKS.
SUPABASE_JWT_SECRET=

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_PREFIX=
NER_MODEL=cahya/bert-base-indonesian-NER
NER_THRESHOLD=0.5
OCR_LANGS=ind+eng

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_HOUR=20
SUBMIT_TIMEOUT_S=30

PLACEMENT_SIM_DUPLICATE=0.95
PLACEMENT_SIM_FAMILY=0.80
